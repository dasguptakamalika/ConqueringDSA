import java.util.Arrays;

class Solution {

    public static void sortBinaryArray(int[] arr) {

        int zeros = 0;

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == 0) {
                zeros++;
            }
        }

        for (int i = 0; i < arr.length; i++) {
            if (i < zeros) {
                arr[i] = 0;
            } else {
                arr[i] = 1;
            }
        }
    }

    public static void main(String[] args) {

        int[] arr = {1, 0, 1, 0, 0, 1};

        sortBinaryArray(arr);

        System.out.println(Arrays.toString(arr));
    }
}  
